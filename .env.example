# ── BetBeat environment ─────────────────────────────────────────────
# Copy to .env.local and fill in. Values here are placeholders only —
# never commit real secrets (B12.1). Validated at boot by lib/security/env.ts.

# ── App ──
# Public base URL of the app (QR links, share cards).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (local dev values come from `supabase start`) ──
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public (anon/publishable) key — safe for the browser, RLS enforced.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Secret (service_role) key — SERVER ONLY. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Direct Postgres connection for the worker and db scripts.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Security ──
# HMAC secret for signing QR / display tokens (32+ random bytes, base64 or hex).
QR_TOKEN_SECRET=replace-with-32-byte-random-secret
# AES-256-GCM key (base64, 32 bytes) for encrypting phones / payout data at rest.
DATA_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# ── Cloudflare Turnstile (anti-bot). Dev defaults: always-pass test keys. ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Payments ──
# Provider: "mock" until Phase 8; then the real PSP adapter name.
PAYMENT_PROVIDER=mock
# Webhook signing secret used by the (mock) PSP.
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret

# ── Notifications (mock until Phase 8) ──
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock

# ── Invoicing (mock until Phase 8) ──
INVOICING_PROVIDER=mock

# ── Catalog (mock until Phase 8) ──
CATALOG_PROVIDER=mock

# ── Observability (optional; wired in Phase 8) ──
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
